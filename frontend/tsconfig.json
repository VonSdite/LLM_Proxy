{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "*": ["node_modules/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../extensions/*/frontend/**/*.ts",
    "../extensions/*/frontend/**/*.vue"
  ],
  "exclude": [
    "../extensions/**/dist/**",
    "../extensions/**/node_modules/**",
    "../extensions/**/test/**",
    "../extensions/**/tests/**",
    "../extensions/**/__tests__/**",
    "../extensions/**/*.test.ts",
    "../extensions/**/*.spec.ts"
  ]
}
